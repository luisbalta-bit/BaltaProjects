[Unit]
Description=Dehesa - editor da loja por pedido (Flask/waitress porta 5056, pre-visualizacao 5057)
After=network.target

[Service]
User=balta
WorkingDirectory=/home/balta/dehesa/editor
Environment=HOME=/home/balta
Environment=PATH=/home/balta/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/balta/dehesa/editor/venv/bin/python app.py
KillMode=mixed
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
